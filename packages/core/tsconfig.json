{
	"compilerOptions": {
		"outDir": "./dist",
		"declaration": true,
		"target": "es5",
		"baseUrl": "./",
		"lib": ["ESNext"],
		"module": "CommonJS",
		"downlevelIteration": true,
		"types": ["node", "vitest/globals"],
		"skipLibCheck": true,
		"strictFunctionTypes": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules"]
}
